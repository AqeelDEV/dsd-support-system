{
  "name": "@dsd/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker: outbox dispatch, notifications, knowledge-base indexing and AI suggestion drafts",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "dead-letter": "node --env-file-if-exists=../../.env dist/cli/dead-letter.js",
    "eval": "node --env-file-if-exists=../../.env dist/cli/eval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@dsd/db": "workspace:*",
    "@dsd/shared": "workspace:*",
    "@google/genai": "catalog:",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "catalog:",
    "nodemailer": "catalog:",
    "openai": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dsd/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
