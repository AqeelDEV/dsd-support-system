{
  "name": "@dsd/api",
  "version": "0.0.0",
  "private": true,
  "description": "HTTP API: every business rule, authentication, authorisation and the audit trail",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "openapi:generate": "node dist/openapi/generate.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\""
  },
  "dependencies": {
    "@dsd/db": "workspace:*",
    "@dsd/shared": "workspace:*",
    "@fastify/helmet": "catalog:",
    "@fastify/static": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/swagger": "catalog:",
    "fastify": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dsd/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
