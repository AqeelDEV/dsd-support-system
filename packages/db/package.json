{
  "name": "@dsd/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL access: connection pools, Drizzle schema, migrations and seed data (server only)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/cli/migrate.js"
  },
  "dependencies": {
    "@dsd/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dsd/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
