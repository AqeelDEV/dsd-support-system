{
  "name": "@dsd/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript, ESLint and Next.js presets, including the workspace dependency boundaries",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/boundaries": "./eslint/boundaries.js",
    "./tsconfig/*": "./tsconfig/*",
    "./next": {
      "types": "./next/index.d.ts",
      "default": "./next/index.js"
    },
    "./next/csp": {
      "types": "./next/csp.d.ts",
      "default": "./next/csp.js"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "next": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript": "^6.0.0",
    "next": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
