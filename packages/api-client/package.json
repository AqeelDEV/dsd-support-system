{
  "name": "@dsd/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed API client generated from the API's OpenAPI document, and the web apps' same-origin API proxy",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client-address": "./src/client-address.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "openapi:generate": "openapi-typescript ../../apps/api/openapi.json --output src/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "catalog:"
  },
  "devDependencies": {
    "@dsd/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
