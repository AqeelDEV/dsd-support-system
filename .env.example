# Development settings. Copy to .env only if you need to change something:
# `docker compose up` works without a .env file.
#
# Docker Compose reads this file to override the defaults in compose.yaml.
# `pnpm --filter @dsd/api start` and `pnpm --filter @dsd/worker start` read
# it too, to run a service on your machine against the compose data stores.
#
# Every value below is for local development only.

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# PostgreSQL superuser, used only by the container's first-time setup and by
# the database tests.
POSTGRES_PASSWORD=postgres-dev-password

# The three database roles (ADR-0008): migrations and seeding, the API, and
# the worker. Changing these after the first `up` needs `docker compose down -v`.
DSD_MIGRATOR_PASSWORD=migrator-dev-password
DSD_API_PASSWORD=api-dev-password
DSD_WORKER_PASSWORD=worker-dev-password

# Credentials for the S3-compatible object store (SeaweedFS). The API uses
# the same pair.
S3_ACCESS_KEY_ID=dsd-dev-access-key
S3_SECRET_ACCESS_KEY=dsd-dev-secret-key

# Host ports. Everything is bound to 127.0.0.1. The data stores stay out of
# Windows' dynamic range (49152-65535); see Troubleshooting in the README.
# If you change one, change the matching URL below too.
POSTGRES_PORT=15432
REDIS_PORT=16379
S3_PORT=18333
API_PORT=4000
CUSTOMER_WEB_PORT=3000
AGENT_WEB_PORT=3001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Running the API or worker on the host (against the compose data stores)
# ---------------------------------------------------------------------------

# The API connects as dsd_api and the worker as dsd_worker. Set the one you
# are running.
DATABASE_URL=postgres://dsd_api:api-dev-password@127.0.0.1:15432/dsd
# DATABASE_URL=postgres://dsd_worker:worker-dev-password@127.0.0.1:15432/dsd
REDIS_URL=redis://127.0.0.1:16379

# API only. Browser origins allowed to call the API directly (comma-separated).
# The web apps use their own proxy and don't need an entry.
CORS_ORIGINS=
# Proxies whose X-Forwarded-For header is trusted (IPs or CIDRs). The API
# trusts the web apps; each web app trusts whatever sits in front of it, such
# as a load balancer. Empty means clients connect directly. Docker Compose
# sets the API's value itself.
TRUST_PROXY=
# API only. Origins that may send state-changing requests (comma-separated):
# both web apps, and the API itself for Swagger UI.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000
# API only. At least 32 characters. Docker Compose uses its own dev default.
AUTH_SECRET=dev-only-auth-secret-never-use-in-production
# API only. "false" drops the Secure flag and the __Host- cookie prefix, which
# browsers refuse on http://localhost. Only allowed when every trusted origin
# is http://localhost or http://127.0.0.1. Leave unset in a real deployment.
COOKIE_SECURE=false
# API only. The object store for attachments, and its bucket. Docker Compose
# points the API at the store over its own network.
S3_ENDPOINT=http://127.0.0.1:18333
S3_BUCKET=dsd-attachments
# API only. The IANA time zone reporting counts calendar days in.
REPORTING_TIMEZONE=UTC

# Worker only. The SMTP server notifications go through: Mailpit, whose web
# UI at http://localhost:8025 shows every email. SMTP_USER and SMTP_PASSWORD
# are optional and go together.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# Worker only. Where links in emails point: the customer app and the agent app.
CUSTOMER_APP_URL=http://localhost:3000
AGENT_APP_URL=http://localhost:3001
# Worker only, like the API: the attachment store, for the orphan sweep.
# S3_ENDPOINT and S3_BUCKET above are shared.

# Worker only. AI reply suggestions (README, "AI-assisted replies"). The
# defaults run everything offline on a deterministic mock: no key, and no
# ticket text leaves the machine. To use a real provider, set it and its key
# here; Docker Compose passes these to the worker.
#   LLM_PROVIDER: mock, gemini, anthropic or openai (openai also needs LLM_MODEL)
#   EMBEDDINGS_PROVIDER: mock, gemini, openai, or none for keyword search only
# One GEMINI_API_KEY covers both of Gemini's models. Changing the embedding
# model makes the worker re-embed the knowledge base when it starts.
LLM_PROVIDER=mock
EMBEDDINGS_PROVIDER=mock
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: a model other than the provider's default (gemini-3.5-flash-lite,
# claude-sonnet-5-5), and how much it reasons (minimal, low, medium, high).
LLM_MODEL=
LLM_EFFORT=
# Optional: how long a customer's message waits for more before it is
# drafted (default 10000 ms), and the mock's failure modes for trying the
# error paths (grounded, malformed, unknown-citation, no-citations,
# insufficient, refuse, throw, hang, compromised).
AI_DEBOUNCE_MS=
MOCK_LLM_MODE=
