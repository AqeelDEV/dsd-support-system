# Development settings. Copy to .env only if you need to change something:
# `docker compose up` works without a .env file.
#
# Docker Compose reads this file to override the defaults in compose.yaml.
# `pnpm --filter @dsd/api start` and `pnpm --filter @dsd/worker start` read
# it too, to run a service on your machine against the compose data stores.
#
# Every value below is for local development only.

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# PostgreSQL superuser, used only by the container's first-time setup and by
# the database tests.
POSTGRES_PASSWORD=postgres-dev-password

# The three database roles (ADR-0008): migrations and seeding, the API, and
# the worker. Changing these after the first `up` needs `docker compose down -v`.
DSD_MIGRATOR_PASSWORD=migrator-dev-password
DSD_API_PASSWORD=api-dev-password
DSD_WORKER_PASSWORD=worker-dev-password

# Credentials for the S3-compatible object store (SeaweedFS).
S3_ACCESS_KEY_ID=dsd-dev-access-key
S3_SECRET_ACCESS_KEY=dsd-dev-secret-key

# Host ports. Everything is bound to 127.0.0.1.
POSTGRES_PORT=55432
REDIS_PORT=56379
API_PORT=4000
CUSTOMER_WEB_PORT=3000
AGENT_WEB_PORT=3001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Running the API or worker on the host (against the compose data stores)
# ---------------------------------------------------------------------------

# The API connects as dsd_api and the worker as dsd_worker. Set the one you
# are running.
DATABASE_URL=postgres://dsd_api:api-dev-password@127.0.0.1:55432/dsd
# DATABASE_URL=postgres://dsd_worker:worker-dev-password@127.0.0.1:55432/dsd
REDIS_URL=redis://127.0.0.1:56379

# API only. Browser origins allowed to call the API directly (comma-separated).
# The web apps use their own proxy and don't need an entry.
CORS_ORIGINS=
# API only. Proxies whose X-Forwarded-For header is trusted (IPs or CIDRs).
TRUST_PROXY=
